---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { Image } from 'astro:assets';
import allProjects from '../data/projects.json';

const base = import.meta.env.BASE_URL;

// An entry with "draft": true stays out of the built site.
const projects = allProjects.filter(p => !p.draft);

// Photos are referenced from projects.json by path. Astro needs a static import
// to optimise them, so glob the whole folder and look each one up by file name.
const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projects/*.{png,jpg,jpeg,webp}',
  { eager: true },
);
const photoFor = (path: string) => {
  const name = path.split('/').pop();
  const hit = Object.entries(photos).find(([k]) => k.endsWith('/' + name));
  return hit?.[1].default;
};
// An entry carries either one "photo" or a "photos" list, with matching "alt"
// or "alts". Pair them up here so the markup only deals with one shape.
const shotsFor = (p: any) => {
  const paths: string[] = p.photos ?? (p.photo ? [p.photo] : []);
  const alts: string[] = p.alts ?? (p.alt ? [p.alt] : []);
  return paths
    .map((path, i) => ({ src: photoFor(path), alt: alts[i] ?? p.title }))
    .filter(s => s.src);
};

// Hardware leads the page. The Micro Center postings reward the build and
// repair work more than the code, so the PC and car work sits above the games.
const KINDS = [
  { kind: 'PC Build', heading: 'PC Builds' },
  { kind: 'Car',      heading: 'Car' },
  { kind: 'Game',     heading: 'Games' },
];
const known = KINDS.map(k => k.kind);
const groups = [
  ...KINDS.map(k => ({ heading: k.heading, items: projects.filter(p => p.kind === k.kind) })),
  { heading: 'Other', items: projects.filter(p => !known.includes(p.kind)) },
].filter(g => g.items.length > 0);
---
<BaseLayout title="Projects">

  <h1 class="text-3xl font-semibold mb-2">Projects</h1>
  <p class="text-[var(--color-text-muted)] leading-relaxed mb-10">
    Machines I have built and code I have written, on my own time.
  </p>

  {groups.map(group => (
    <section class="mb-12">
      <h2 class="text-sm font-semibold uppercase tracking-widest text-[var(--color-accent)] mb-5">{group.heading}</h2>

      <div class="space-y-8">
        {group.items.map(p => {
          const shots = shotsFor(p);
          return (
          <article class="border-l-2 border-[var(--color-border)] pl-5">
            <div class="flex flex-wrap items-baseline gap-x-3 mb-2">
              <h3 class="text-lg font-semibold">{p.title}</h3>
              <span class="text-sm text-[var(--color-text-muted)]">{p.year}</span>
            </div>

            <p class="text-[var(--color-text)] leading-relaxed mb-4">{p.summary}</p>

            {p.demo && (
              <figure class="mb-4">
                <img src={`${base}${p.demo}`} alt={p.demoAlt ?? p.title} loading="lazy"
                     class="rounded-sm border border-[var(--color-border)] w-full max-w-lg h-auto" />
                {p.demoCaption && (
                  <figcaption class="text-xs text-[var(--color-text-muted)] mt-2">{p.demoCaption}</figcaption>
                )}
              </figure>
            )}

            {shots.length > 0 && (
              <figure class="mb-4 flex flex-wrap gap-3">
                {shots.map(s => (
                  <Image src={s.src} alt={s.alt} widths={[400, 800]}
                         sizes="(min-width: 640px) 24rem, 100vw" loading="lazy"
                         class="rounded-sm border border-[var(--color-border)] w-auto max-w-sm max-h-96 object-contain" />
                ))}
              </figure>
            )}

            {p.specs.length > 0 && (
              <ul class="text-sm text-[var(--color-text-muted)] mb-4 grid sm:grid-cols-2 gap-x-6 gap-y-1">
                {p.specs.map(s => <li>{s}</li>)}
              </ul>
            )}

            {p.notes.length > 0 && (
              <ul class="space-y-2 text-[var(--color-text)] leading-relaxed list-disc pl-5 mb-4">
                {p.notes.map(n => <li>{n}</li>)}
              </ul>
            )}

            {p.links.length > 0 && (
              <p class="text-sm flex flex-wrap gap-4">
                {p.links.map(l => (
                  <a href={l.href} target="_blank" rel="noopener noreferrer"
                     class="text-[var(--color-accent)] hover:text-[var(--color-accent-hover)]">{l.label}</a>
                ))}
              </p>
            )}
          </article>
          );
        })}
      </div>
    </section>
  ))}

</BaseLayout>
