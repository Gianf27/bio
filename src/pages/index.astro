---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';
const base = import.meta.env.BASE_URL;
// TODO: name the Education courses once Gian confirms which ones he has passed.
// The expected graduation date is left off on purpose. Brendon's call, 2026-09-29:
// the degree is taking longer than four years and a date invites the arithmetic.
---
<BaseLayout title="About">

  <!-- Hero -->
  <section class="flex flex-col sm:flex-row gap-8 items-start mb-12">
    <Image src={headshot} alt="Gian Ferre" width={200} height={200} densities={[1, 2]}
           class="rounded-sm object-cover flex-shrink-0 w-36 sm:w-50 h-auto" />
    <div>
      <h1 class="text-3xl font-semibold text-[var(--color-text)] mb-2">Gian Ferre</h1>
      <p class="text-lg text-[var(--color-text-muted)] mb-4">
        Computer Science student &middot; Houston, TX
      </p>
      <p class="text-[var(--color-text)] leading-relaxed">
        I build high-performance PCs for gaming, HPC and AI work. I write my own
        games in Python. I have spent three years serving guests in busy Houston
        restaurants. Picking parts for someone's first build and walking a table
        through a menu come down to the same thing. Find out what the person
        actually wants, then tell them the truth about their options.
      </p>
    </div>
  </section>

  <!-- What I do -->
  <section class="mb-10">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-[var(--color-accent)] mb-4">What I Do</h2>
    <ul class="space-y-3 text-[var(--color-text)] leading-relaxed">
      <li>
        <strong>Build PCs.</strong> High-performance builds for myself, for family, and for
        friends, for gaming and for AI work.
        I spec to a budget, check compatibility before anything gets ordered, assemble
        and cable it, then stress test and watch the thermals before it goes out the door.
      </li>
      <li>
        <strong>Write games in Python.</strong> An
        <a href="https://github.com/Gianf27/Asteroids" target="_blank" rel="noopener noreferrer"
           class="text-[var(--color-accent)] hover:text-[var(--color-accent-hover)]">Asteroids</a>
        clone in Pygame, with sprite groups, delta-time movement, and rocks that split
        when you shoot them.
        <a href="https://github.com/Gianf27/DestinyDungeon" target="_blank" rel="noopener noreferrer"
           class="text-[var(--color-accent)] hover:text-[var(--color-accent-hover)]">Destiny Dungeon</a>,
        a text RPG where a Llama 3.3 70B model runs the story around your real
        Destiny 2 character.
      </li>
      <li>
        <strong>Work on my car.</strong> I do my own maintenance and modification
        work. Same instinct as building a PC. I research the part, do the job
        myself, and find out what actually broke instead of guessing.
      </li>
      <li>
        <strong>Take care of customers.</strong> Three years on the floor at Yi Peng
        Thai Dining, 15 to 20 tables a shift, plus hosting, bussing, and a summer as a
        lifeguard watching 100+ swimmers a day.
      </li>
    </ul>
  </section>

  <!-- What I'm looking for -->
  <section class="mb-10 bg-[var(--color-surface)] border border-[var(--color-border)] rounded-sm p-6">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-[var(--color-accent)] mb-4">What I'm Looking For</h2>
    <p class="text-[var(--color-text)] leading-relaxed">
      A customer-facing role on a retail technology floor, in Houston, while I finish
      my degree. I want to spend my shift helping people pick the
      right hardware and sorting out what went wrong with theirs. I am available
      nights, weekends, and holidays.
    </p>
  </section>

  <!-- Education -->
  <section class="mb-10">
    <h2 class="text-sm font-semibold uppercase tracking-widest text-[var(--color-accent)] mb-4">Education</h2>
    <div class="space-y-4 text-[var(--color-text)] leading-relaxed">
      <p>
        <strong>Houston Community College</strong> — Computer Science coursework,
        transferring back to the University of Houston.
      </p>
      <p>
        <strong>University of Houston</strong> — B.S. in Computer Science.
        Three semesters completed.
      </p>
      <p>
        <strong>Clear Creek High School</strong> — League City, TX.
      </p>
    </div>
    <p class="mt-4">
      <a href={`${base}projects`} class="text-[var(--color-accent)] hover:text-[var(--color-accent-hover)]">
        See the projects &rarr;
      </a>
    </p>
  </section>

</BaseLayout>
